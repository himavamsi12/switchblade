# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env
.env*.local

# payload
/payload.db
/media

# bulk classics import — real data/images are local-only, only the template is tracked
/classics-import/data.csv
/classics-import/images/*
!/classics-import/images/.gitkeep

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# Client source decks — large binaries, content already imported via classics-import
*.pptx
*.ppt

# Font license paperwork. Kept OUT of the repo deliberately: these carry a license key and the
# licensee's personal email, and one of this project's remotes is a public GitHub repo, so a
# stray `git add .` would publish both. Store them somewhere private instead.
License.pdf
*licen[cs]e*.pdf
